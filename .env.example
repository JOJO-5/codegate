# Local test: leave these values as shown and run docker compose up -d --build.
# For public HTTPS: set both values to your real domain, then use --profile public.
CODEGATE_DOMAIN=codegate.example.com
CODEGATE_BASE_URL=http://127.0.0.1:8080

# HTTPS deployment: auto reuses CODEGATE_BASE_URL's domain on HTTPS port 8443.
# Allow inbound TCP 8443. No additional subdomain or certificate is needed.
# Custom reverse proxy: set another HTTPS origin forwarded to server:8080.
CODEGATE_DSH_PROXY_URL=auto
